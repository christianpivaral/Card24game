<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="14"
      prefHeight="650.0"
      prefWidth="800.0"
      styleClass="main-background"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.card24game.HelloController">

    <padding>
        <Insets top="25" right="45" bottom="25" left="45"/>
    </padding>

    <!-- Title -->
    <VBox alignment="CENTER" spacing="2">
        <Label text="CARD 24" styleClass="game-logo"/>
        <Label text="ARITHMETIC CHALLENGE" styleClass="game-subtitle"/>
    </VBox>

    <!-- Target -->
    <HBox alignment="CENTER" spacing="8">
        <Label text="TARGET" styleClass="target-label"/>
        <Label text="24" styleClass="target-number"/>
    </HBox>

    <!-- Card area -->
    <VBox alignment="CENTER"
          spacing="12"
          maxWidth="620"
          styleClass="game-panel">

        <padding>
            <Insets top="16" right="20" bottom="18" left="20"/>
        </padding>

        <Label text="YOUR HAND" styleClass="section-label"/>

        <HBox alignment="CENTER" spacing="18">

            <StackPane styleClass="card">
                <ImageView fx:id="card1"
                           fitHeight="160"
                           fitWidth="105"
                           preserveRatio="true"/>
            </StackPane>

            <StackPane styleClass="card">
                <ImageView fx:id="card2"
                           fitHeight="160"
                           fitWidth="105"
                           preserveRatio="true"/>
            </StackPane>

            <StackPane styleClass="card">
                <ImageView fx:id="card3"
                           fitHeight="160"
                           fitWidth="105"
                           preserveRatio="true"/>
            </StackPane>

            <StackPane styleClass="card">
                <ImageView fx:id="card4"
                           fitHeight="160"
                           fitWidth="105"
                           preserveRatio="true"/>
            </StackPane>

        </HBox>

    </VBox>

    <!-- Expression area -->
    <VBox alignment="CENTER" spacing="8">

        <Label text="MAKE THE CARDS = 24"
               styleClass="challenge-label"/>

        <Label text="ENTER YOUR EXPRESSION"
               styleClass="input-label"/>

        <TextField fx:id="expressionField"
                   maxWidth="460"
                   prefHeight="44"
                   promptText="Example: (8 - 2) * (3 + 1)"
                   styleClass="expression-field"/>

    </VBox>

    <!-- Required buttons -->
    <HBox alignment="CENTER" spacing="12">

        <Button text="Verify"
                prefWidth="150"
                prefHeight="42"
                styleClass="verify-button"
                onAction="#verifyExpression"/>

        <Button text="Refresh"
                prefWidth="150"
                prefHeight="42"
                styleClass="refresh-button"
                onAction="#refreshCards"/>

    </HBox>

    <!-- Arcade decoration -->
    <HBox alignment="CENTER" spacing="22">
        <Label text="+" styleClass="math-symbol"/>
        <Label text="−" styleClass="math-symbol"/>
        <Label text="×" styleClass="math-symbol"/>
        <Label text="÷" styleClass="math-symbol"/>
    </HBox>

</VBox>